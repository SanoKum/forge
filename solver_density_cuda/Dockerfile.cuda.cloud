# Cloud image (CUDA) for forge/solver_density_cuda on cloud instances.
# Dockerfile.cuda.dev から ParaView GUI / Qt / X サーバ系を除いた軽量版。
# gmsh はヘッドレス (python API / -nopopup バッチ) で同梱し、メッシュ生成もクラウドで完結する。
# 可視化は pvserver (ホスト側) or 後処理 PNG (matplotlib) で行う → procedures/cloud-aws-gpu.md
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG GMSH_VERSION=4.15.2

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git pkg-config \
    curl python3 python3-pip python-is-python3 \
    python3-h5py python3-numpy python3-matplotlib \
    libhdf5-dev libyaml-cpp-dev libmetis-dev \
    libgl1 libglu1-mesa libxcursor1 libxft2 libxinerama1 \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# gmsh は PyPI wheel のみで導入する (python API + CLI 実行ファイル同梱)。
# gmsh.info のバイナリ tarball は配布サーバが不安定なため使わない (2026-08-30 接続不可を確認)。
RUN python3 -m pip install --no-cache-dir "gmsh==${GMSH_VERSION}" \
 && gmsh --version

# Ubuntu の HDF5 (serial) の典型パス (tools/build.sh が CMake へ渡す)
ENV HDF5_INC=/usr/include/hdf5/serial \
    HDF5_LIBDIR=/usr/lib/x86_64-linux-gnu/hdf5/serial

WORKDIR /workspace
