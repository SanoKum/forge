# Development image (CUDA) for forge/solver_density_cuda
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG GMSH_VERSION=4.15.2

# 開発ツール & ライブラリ（HDF5/YAML/METIS）＋ ParaView
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git pkg-config gdb gfortran \
    curl python3 python3-pip python-is-python3 \
    python3-h5py \
    libhdf5-dev libyaml-cpp-dev libmetis-dev \
    libgl1 libglu1-mesa libxcursor1 libxft2 libxinerama1 libqt5svg5 \
    adwaita-icon-theme \
    paraview ca-certificates xauth locales \
 && locale-gen en_US.UTF-8 \
 && curl -fsSL "https://gmsh.info/bin/Linux/gmsh-${GMSH_VERSION}-Linux64.tgz" -o /tmp/gmsh.tgz \
 && tar -xzf /tmp/gmsh.tgz -C /opt \
 && python3 -m pip install --no-cache-dir --upgrade "gmsh==${GMSH_VERSION}" \
 && ln -sf "/opt/gmsh-${GMSH_VERSION}-Linux64/bin/gmsh" /usr/local/bin/gmsh \
 && rm -f /tmp/gmsh.tgz \
 && rm -rf /var/lib/apt/lists/*

# UbuntuのHDF5(serial)の典型パス（あなたのCMakeの -D に使う用）
ENV HDF5_INC=/usr/include/hdf5/serial \
    HDF5_LIBDIR=/usr/lib/x86_64-linux-gnu/hdf5/serial

WORKDIR /workspace

